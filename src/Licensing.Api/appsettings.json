{
  "ConnectionStrings": {
    "Default": "Server=.;Database=LicensingPlatform;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False",
    "Redis": ""
  },
  "Database": { "Provider": "SqlServer" },
  "Jwt": {
    "Issuer": "licensing-platform",
    "Audience": "licensing-platform",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "ClientTokenMinutes": 60
  },
  "Security": { "SecretPepper": "" },
  "LicenseSigning": { "Issuer": "licensing-platform", "KeyStorePath": "App_Data/signing-keys" },
  "DataProtection": { "KeyRingPath": "App_Data/dp-keys" },
  "Seed": { "ApplyMigrations": false, "AdminEmail": "", "AdminPassword": "", "DemoData": false },
  "Outbox": { "Enabled": true, "PollSeconds": 5, "BatchSize": 50, "MaxAttempts": 8 },
  "Jobs": { "Enabled": true, "ExpiryIntervalMinutes": 60, "MaintenanceIntervalMinutes": 1440, "BatchSize": 500, "AuditRetentionDays": 365 },
  "RateLimits": { "LoginPerMinute": 10, "ClientTokenPerMinute": 30, "LicensingPerMinute": 300 },
  "Cors": { "Origins": [ "http://localhost:4200" ] },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
    }
  },
  "AllowedHosts": "*"
}
